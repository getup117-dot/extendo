{
  // エクステン堂（public フォルダの中身をそのまま公開）
  // /api/ で始まる道だけ src/worker.js が担当する（神経ド衰弱のAIお題生成など）
  "name": "extendo",
  "compatibility_date": "2026-11-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // ベイ出没マップ（/bey/）の投稿を保存する場所
  "durable_objects": {
    "bindings": [{ "name": "BEY_STORE", "class_name": "BeyStore" }]
  },
  "migrations": [{ "tag": "bey-v1", "new_sqlite_classes": ["BeyStore"] }]
}
